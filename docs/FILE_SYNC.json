    },
    {
      "pattern": "dist/**",
      "reason": "비추적 빌드 출력; 원본·추적 생성물은 별도 등록"
    },
    {
      "pattern": ".cache/**",
      "reason": "비추적 캐시"
    },
    {
      "pattern": "coverage/**",
      "reason": "비추적 테스트 커버리지"
    },
    {
      "pattern": "artifacts/**",
      "reason": "비추적 로컬 검증 출력"
    }
  ],
  "external_dependencies": [
    {
      "path": "/workspace/efsimulator-environment/activate.sh",
      "role": "저장소 밖의 개발 도구 활성화와 npm 캐시 설정",
      "check": "새 셸에서 source 후 node --version=v24.19.0, npm --version=11.9.0 확인"
    },
    {
      "path": "/workspace/efsimulator-environment/efsimulator 새 환경 인수인계.md",
